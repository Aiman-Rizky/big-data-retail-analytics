# Salin file ini menjadi .env, lalu sesuaikan nilainya.
DATASET_ROOT=../Synthetic Retail Dataset - 10 Million Transactions
DATASET_VARIANT=retail_contaminated_dataset

# PostgreSQL lab. Jangan isi password asli di file yang di-commit.
PGHOST=localhost
PGPORT=5432
PGDATABASE=big_data_retail
PGUSER=postgres
PGPASSWORD=ganti_dengan_password_anda
PGSCHEMA=retail_analytics
ENABLE_POSTGRES_LOAD=0
LOAD_FULL_DETAIL=0

